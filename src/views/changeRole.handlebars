<!-- changeRole.handlebars -->
<h1>Cambiar Rol de Usuario</h1>

{{#if user}}
  {{#if isPremium}}
    <p>Ya eres un usuario Premium. ¿Quieres cambiar a usuario estándar?</p>
    <form id="change-role-form" action="/api/sessions/change-role/{{user._id}}" method="POST">
        <input type="hidden" name="role" value="user">
        <button type="submit">Cambiar a Usuario Normal</button>
    </form>
  {{else}}
    <p>Sube comprobante de identificación, de domicilio y estado de cuenta, para cambiar a un usuario Premium:</p>
    <form id="upload-documents-form" action="/api/sessions/{{user._id}}/documents" method="POST" enctype="multipart/form-data">
        <input type="file" name="documents" multiple required>
        <button type="submit">Subir Documentos</button>
    </form>

    <!-- Botón para cambiar a premium después de subir los documentos -->
    <form id="change-role-form" action="/api/sessions/change-role/{{user._id}}" method="POST">
        <input type="hidden" name="role" value="premium">
        <button type="submit">Cambiar a Premium</button>
    </form>
  {{/if}}
{{else}}
  <p>Usuario no encontrado o no autenticado.</p>
{{/if}}

<script>
    document.getElementById('upload-documents-form').addEventListener('submit', async function(event) {
        event.preventDefault();
        
        const form = event.target;
        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                alert('Documentos subidos correctamente. Ahora puedes cambiar a Premium.');
            } else {
                const errorData = await response.json();
                alert(errorData.error || 'Error al subir documentos');
            }
        } catch (error) {
            console.error('Error en la solicitud:', error);
            alert('Error al subir documentos. Inténtalo de nuevo.');
        }
    });

    document.querySelectorAll('#change-role-form').forEach(form => {
        form.addEventListener('submit', async function(event) {
            event.preventDefault();

            const formData = new FormData(form);
            const role = formData.get('role');

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ role })
                });

                if (response.ok) {
                    let message = role === 'premium' ? '¡Felicidades! Ahora eres un usuario Premium.' : 'Has cambiado a un usuario estándar.';
                    alert(message);
                    window.location.href = '/api/sessions/current';
                } else {
                    const errorData = await response.json();
                    alert(errorData.error || 'Error al cambiar el rol');
                }
            } catch (error) {
                console.error('Error en fetch:', error);
                alert('Error al cambiar el rol. Inténtalo de nuevo.');
            }
        });
    });
</script>
