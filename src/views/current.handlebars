<div class="profile">
    <!-- current.handlebars -->
    <h1>Perfil de Usuario</h1>

    <p>Nombre: {{user.first_name}}</p>
    <p>Apellido: {{user.last_name}}</p>
    <p>Email: {{user.email}}</p>
    <p>Rol: {{user.role}}</p>
</div>

<!-- Botón de cambiar rol -->
<form id="go-to-change-role-form" action="/api/sessions/change-role" method="GET">
    <button type="submit">Cambiar Rol</button>
</form>


<script>
    document.getElementById('change-role-form').addEventListener('submit', async function(event) {
        event.preventDefault();

        const form = event.target;
        const formData = new FormData(form);
        const role = formData.get('role');

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ role })
            });

            if (response.ok) {
                let message = role === 'premium' ? '¡Felicidades! Ahora eres un usuario Premium.' : 'Has cambiado a un usuario estándar.';
                alert(message);
                window.location.href = '/api/sessions/current';
            } else {
                const errorData = await response.json();
                alert(errorData.error || 'Error al cambiar el rol');
            }
        } catch (error) {
            console.error('Error en fetch:', error);
            alert('Error al cambiar el rol. Inténtalo de nuevo.');
        }
    });
</script>
